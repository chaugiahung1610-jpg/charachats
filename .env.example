# Recommended for real use:
# Point the frontend at your own backend/serverless route so the Gemini key never ships to the browser.
VITE_GEMINI_ENDPOINT=/api/gemini

# Local-only fallback:
# This works during quick prototyping, but any VITE_* value is bundled into browser code.
# Do not use this for a public deployment.
# VITE_GEMINI_KEY=your_local_test_key_here
